{
  "name": "webgame-cuubz",
  "version": "1.0.0",
  "description": "A web-based Minecraft-style voxel game with full multiplayer support for up to 4 players, procedural texture generation, and persistent worlds.",
  "main": "index.js",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:count": "node scripts/count-assertions.js",
    "test:e2e": "npm run build && node test/e2e/saveLoad.js",
    "test:e2e:vite": "node test/e2e/saveLoad.js --server=vite",
    "test:e2e:mp": "npm run build && node test/e2e/multiplayer.js",
    "lint": "eslint .",
    "lint:ci": "eslint . --quiet",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "generate-manifest": "node scripts/generate-manifest.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "pngjs": "^7.0.0",
    "three": "0.134.0",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "eslint": "^10.8.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.0.1",
    "playwright-core": "^1.62.0",
    "prettier": "^3.9.6",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
