{
  "name": "webgame-cuubz",
  "version": "1.0.0",
  "description": "A web-based Minecraft-style voxel game with full multiplayer support for up to 4 players, procedural texture generation, and persistent worlds.",
  "main": "index.js",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "bash test/run_tests.sh",
    "test:e2e": "npm run build && node test/e2e/saveLoad.js",
    "test:e2e:vite": "node test/e2e/saveLoad.js --server=vite",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "generate-manifest": "node scripts/generate-manifest.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "pngjs": "^7.0.0",
    "three": "0.134.0",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "eslint": "^10.8.0",
    "jsdom": "^30.0.1",
    "playwright-core": "^1.62.0",
    "prettier": "^3.9.6",
    "vite": "^8.1.5"
  }
}
